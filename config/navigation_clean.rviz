Panels:
  - Class: rviz_common/Displays
    Name: 导航模式 (障碍物 0.2~1.4m)
    Property Tree Widget:
      Expanded:
        - /2D地图1
        - /Global Costmap1
        - /Local Costmap1
        - /导航路径1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: 俯视图
      Scale: 100
      Target Frame: base_link
      X: 0
      Y: 0
  Displays:
    # ====== 核心：2D 占用地图 ======
    - Class: rviz_default_plugins/Map
      Name: 2D地图
      Topic: /factor_perception/map
      Color Scheme: map
      Alpha: 0.7
      Enabled: true

    # ====== 核心：Nav2 代价地图 ======
    - Class: rviz_default_plugins/Map
      Name: Global Costmap (0.2~1.4m)
      Topic: /global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
      Enabled: true

    - Class: rviz_default_plugins/Map
      Name: Local Costmap (0.2~1.4m)
      Topic: /local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
      Enabled: true

    # ====== 导航路径 ======
    - Class: rviz_default_plugins/Path
      Name: 导航路径
      Topic: /plan
      Color: 0; 255; 255
      Alpha: 1.0
      Enabled: true

    - Class: rviz_default_plugins/Path
      Name: 全局路径
      Topic: /factor_perception/global_path
      Color: 255; 255; 0
      Alpha: 0.8
      Enabled: true

    # ====== 位姿 ======
    - Class: rviz_default_plugins/Pose
      Name: 当前位姿
      Topic: /factor_perception/localization_pose
      Shape: Arrow
      Color: 255; 255; 0
      Enabled: true

    - Class: rviz_default_plugins/PoseStamped
      Name: 导航目标
      Topic: /goal_pose
      Color: 255; 0; 255
      Enabled: true

    # ====== TF ======
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Arrows: false
      Show Names: true
      Show Axes: true
      Enabled: true

    # ====== 网格 ======
    - Class: rviz_default_plugins/Grid
      Name: 网格
      Reference Frame: map
      Plane Cell Count: 40
      Color: 160; 160; 160
      Enabled: true

    # ====== 点云（默认关闭，需要时手动开启）======
    - Class: rviz_default_plugins/PointCloud2
      Name: 障碍物点云 (0.2~1.4m)
      Topic: /factor_perception/cloud_obstacles
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Alpha: 0.8
      Enabled: false

    - Class: rviz_default_plugins/PointCloud2
      Name: 地面点云 (<0.2m)
      Topic: /factor_perception/cloud_ground
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 80; 200; 80
      Alpha: 0.6
      Enabled: false

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /factor_perception/initialpose
    - Class: rviz_default_plugins/SetGoalPose
      Topic: /goal_pose

Window Geometry:
  Displays:
    collapsed: false
  Width: 1200
  Height: 800
