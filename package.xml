<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav24r</name>
  <version>2.0.0</version>
  <description>人形机器人自主导航系统 - 基于 ROS2 Jazzy，集成 Factor Perception SDK、RTAB-Map SLAM 和 Nav2 导航栈。</description>
  <maintainer email="todo@example.com">nav24r</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Python deps (installed separately via pip) -->
  <!-- pyyaml, tkinter (system) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
